# --- エディタの書式の決まり（WORKSPACE.md 1 節）---

# --- 上のフォルダの .editorconfig を読まない（WORKSPACE.md 1 節）---
root = true

# --- すべてのファイルの書式（WORKSPACE.md 1 節）---
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# --- Markdown は行末の空白を残す（WORKSPACE.md 1 節）---
[*.md]
trim_trailing_whitespace = false

# --- 表の形のデータは行末の空白を残す（WORKSPACE.md 1 節）---
[*.{csv,csv2,csvy,tsv,psv,dat,fwf}]
trim_trailing_whitespace = false

# --- Makefile と project.mk はタブで字下げする（WORKSPACE.md 1 節）---
[{Makefile,project.mk}]
indent_style = tab

# --- Dockerfile と DESCRIPTION は 4 字で字下げする（WORKSPACE.md 1 節）---
[{Dockerfile,DESCRIPTION}]
indent_size = 4

# --- 受け取ったデータには書式の決まりを当てない（WORKSPACE.md 1 節）---
[data/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
