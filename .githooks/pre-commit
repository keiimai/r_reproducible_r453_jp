#!/usr/bin/env bash
# --- コミット前の検査（WORKSPACE.md 3 節）---

# --- 未定義の変数で止め、パイプの途中の失敗もパイプの失敗にする（WORKSPACE.md 3 節）---
set -uo pipefail

# --- コンテナの中ではコミットしない（WORKSPACE.md 3 節）---
if [ -f /opt/build-info.json ]; then
  printf '\033[31m[pre-commit]\033[0m %s\n' "コンテナの中でコミットしようとしています。コミットはホスト（PC のターミナルなど）で行ってください。" >&2
  exit 1
fi

# --- リポジトリの根に移る（WORKSPACE.md 3 節）---
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

# --- ステージされたものを見るか、追跡中の全ファイル（--all）を見るか（WORKSPACE.md 3 節）---
mode=staged
[ "${1:-}" = "--all" ] && mode=all

# --- 指摘を集め（Docker で R の検査ができないことは分けて）、最後にまとめて止める（WORKSPACE.md 3 節）---
fail=0
docker_ng=0
ng() { printf '\033[31m[pre-commit]\033[0m %s\n' "$1" >&2; fail=1; }
ng_docker() { printf '\033[31m[pre-commit]\033[0m %s\n' "$1" >&2; docker_ng=1; }
finish() {
  if [ "$fail" -ne 0 ]; then
    [ "$mode" = all ] && echo "[pre-commit] 追跡中のファイルに指摘があります。上の案内に従って直してください。" >&2 \
      || echo "[pre-commit] コミットを止めました。上の指摘を直して、git add してからもう一度 commit してください。" >&2
  fi
  if [ "$docker_ng" -ne 0 ]; then
    echo "[pre-commit] Docker で R の検査ができませんでした。上の案内のとおりにしてから、もう一度実行してください。" >&2
  fi
  [ "$fail" -eq 0 ] && [ "$docker_ng" -eq 0 ] || exit 1
  exit 0
}

# --- 1. renv.lock がコミットに含まれているか（WORKSPACE.md 3 節）---
if ! git ls-files --error-unmatch renv.lock >/dev/null 2>&1; then
  ng "renv.lock がコミットに含まれていません。make lock のあと git add renv.lock してください。"
fi

# --- 検査するファイルの一覧（WORKSPACE.md 3 節）---
files=()
if [ "$mode" = all ]; then
  while IFS= read -r -d '' f; do files+=("$f"); done < <(git ls-files -z)
else
  while IFS= read -r -d '' f; do files+=("$f"); done \
    < <(git diff --cached --name-only --diff-filter=ACMRT -z)
fi
if [ "${#files[@]}" -eq 0 ]; then
  finish
fi

# --- 2. data/ 配下の実データ（R を使わない）（WORKSPACE.md 3 節）---
blocked=()
for f in "${files[@]}"; do
  case "$f" in
    data/README.md | data/.gitkeep | data/*/.gitkeep) ;;
    data/*) blocked+=("$f") ;;
  esac
done
if [ "${#blocked[@]}" -gt 0 ]; then
  ng "data/ 配下の実データが Git に入っています:"
  printf '        %s\n' "${blocked[@]}" >&2
  echo "        データ本体は追跡しません。repro_run() の inputs に渡したファイルは、SHA-256 が実行の記録" >&2
  echo "        （outputs/repro/<run_id>/<run_id>_run.json）に残ります。追跡から外すには（手元のファイルは消えない）:" >&2
  printf '          git rm --cached' >&2
  printf " '%s'" "${blocked[@]}" >&2
  printf '\n' >&2
fi

# --- 3. outputs/・models/ 配下の成果物（R を使わない）（WORKSPACE.md 3 節）---
produced=()
for f in "${files[@]}"; do
  case "$f" in
    outputs/.gitkeep | outputs/*/.gitkeep | models/.gitkeep) ;;
    outputs/* | models/*) produced+=("$f") ;;
  esac
done
if [ "${#produced[@]}" -gt 0 ]; then
  ng "outputs/・models/ 配下の成果物が Git に入っています:"
  printf '        %s\n' "${produced[@]}" >&2
  echo "        成果物は追跡しません。state\$artifacts に入れたファイルは、SHA-256 が実行の記録に残ります。追跡から外すには（手元のファイルは消えない）:" >&2
  printf '          git rm --cached' >&2
  printf " '%s'" "${produced[@]}" >&2
  printf '\n' >&2
fi

# --- 4. 秘密情報を書く .env（R を使わない）（WORKSPACE.md 3 節）---
env_files=()
for f in "${files[@]}"; do
  case "${f##*/}" in
    .env.example) ;;
    .env | .env.* | *.env) env_files+=("$f") ;;
  esac
done
if [ "${#env_files[@]}" -gt 0 ]; then
  ng "秘密情報を書くファイル（.env）が Git に入っています:"
  printf '        %s\n' "${env_files[@]}" >&2
  echo "        .env は Git で追跡しません（雛形は .env.example）。追跡から外すには（手元のファイルは消えない）:" >&2
  printf '          git rm --cached' >&2
  printf " '%s'" "${env_files[@]}" >&2
  printf '\n' >&2
  echo "        push 済みなら、中のトークンやパスワードは漏れたものとして無効にしてください。" >&2
fi

# --- 5. data/ の外にある、データの形式のファイル（R を使わない）（WORKSPACE.md 3 節）---
data_extensions=" csv csv2 csvy tsv psv dat dif fwf rec mtp syd arff dbf dump xlsx xls xlsm xlsb xltx xltm ods fods numbers jmp sas7bdat xpt sav zsav por dta rds rda rdata qs2 fst feather parquet arrow pzfx mat wf1 pkl pickle joblib npy npz h5 hdf5 sqlite sqlite3 db accdb mdb zip gz gzip bz2 bzip2 tar tgz tbz2 "
outside=()
for f in "${files[@]}"; do
  case "$f" in data/* | outputs/* | models/* | docs/definition/* | configs/* | tests/testthat/*) continue ;; esac
  name="${f##*/}"
  case "$name" in *.*) ;; *) continue ;; esac
  extension="$(printf '%s' "${name##*.}" | tr '[:upper:]' '[:lower:]')"
  case "$data_extensions" in *" ${extension} "*) outside+=("$f") ;; esac
done
if [ "${#outside[@]}" -gt 0 ]; then
  ng "data/ の外に、データの形式のファイルがあります（置いてよいのは docs/definition/・configs/・tests/testthat/ だけ）:"
  printf '        %s\n' "${outside[@]}" >&2
  echo "        データは data/ に置きます（Git で追跡しない）。追跡から外すには（手元のファイルは消えない）:" >&2
  printf '          git rm --cached' >&2
  printf " '%s'" "${outside[@]}" >&2
  printf '\n' >&2
fi

# --- 6. .gitignore が外すのに、git add -f で入れたファイル（R を使わない）（WORKSPACE.md 3 節）---
forced=()
while IFS= read -r -d '' f; do
  case "$f" in data/* | outputs/* | models/*) continue ;; esac
  case "${f##*/}" in .env | .env.* | *.env) continue ;; esac
  extension="$(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]')"
  case "$data_extensions" in *" ${extension} "*) continue ;; esac
  forced+=("$f")
done < <(printf '%s\0' "${files[@]}" | git -c core.excludesFile=/dev/null check-ignore --no-index --stdin -z)
if [ "${#forced[@]}" -gt 0 ]; then
  ng ".gitignore が外しているファイルが、git add -f で Git に入っています:"
  printf '        %s\n' "${forced[@]}" >&2
  echo "        描画した文書と図・R の履歴・鍵などは追跡しません。追跡から外すには（手元のファイルは消えない）:" >&2
  printf '          git rm --cached' >&2
  printf " '%s'" "${forced[@]}" >&2
  printf '\n' >&2
fi

# --- 7. 大文字小文字だけが違うファイル名・フォルダ名（R を使わない）（WORKSPACE.md 3 節）---
dup="$(git ls-files -z | tr '\0' '\n' | awk -F/ '{p=$1; print p; for (i=2;i<=NF;i++) {p=p"/"$i; print p}}' | sort -u | tr '[:upper:]' '[:lower:]' | sort | uniq -d)"
if [ -n "$dup" ]; then
  ng "大文字小文字だけが違うファイル名・フォルダ名があります（macOS や Windows では同じ名前として衝突します）:"
  printf '        %s\n' "$dup" >&2
fi

# --- 8. 衝突の印（マージ・rebase・cherry-pick・revert の途中だけ）（R を使わない）（WORKSPACE.md 3 節）---
in_conflict=0
for state in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  [ -e "$(git rev-parse --git-path "$state")" ] && in_conflict=1
done
if [ "$in_conflict" -eq 1 ]; then
  for f in "${files[@]}"; do
    if git grep --cached -I -q -E '^(<{7} |={7}$|>{7} )' -- ":(literal)$f"; then
      ng "$f: 衝突の印（<<<<<<< / ======= / >>>>>>>）が残っています"
    fi
  done
fi

# --- 9. 名前がテンプレートの値のままの docker-compose.yml（止めずに知らせる。R を使わない）（WORKSPACE.md 3 節）---
if [ "$mode" = staged ] && printf '%s\n' "${files[@]}" | grep -x 'docker-compose.yml' >/dev/null; then
  staged_name="$(git show :docker-compose.yml 2>/dev/null | sed -n 's/^name: \([a-z0-9]*\)$/\1/p')"
  if [ -n "$staged_name" ]; then
    printf '\033[31m[pre-commit]\033[0m %s\n' "docker-compose.yml の name: がテンプレートの値（${staged_name}）のままコミットされます（コミットは止めません）。" >&2
    echo "        プロジェクトなら、make rename の後に git add docker-compose.yml して、コミットし直してください（git commit --amend）。" >&2
  fi
fi

# --- 10. 検査する中身を一時フォルダ（$TMPDIR）に書き出す（WORKSPACE.md 3 節）---
tmp="$(mktemp -d "${TMPDIR:-/tmp}/precommit.XXXXXX")" || exit 1
trap 'rm -rf "$tmp"' EXIT
list="$tmp/files"
printf '%s\n' "${files[@]}" > "$list"
if [ "$mode" = all ]; then
  content_root="$root"
else
  content_root="$tmp/index"
  mkdir -p "$content_root"
  if ! printf '%s\0' "${files[@]}" | git checkout-index --prefix="$content_root/" -z --stdin; then
    ng "ステージされた内容を書き出せませんでした（git checkout-index が失敗）。検査できないので止めます。"
    finish
  fi
fi

# --- CI では、その場の Rscript で検査する（WORKSPACE.md 3 節）---
if [ -n "${CI:-}" ]; then
  Rscript --vanilla tools/precommit_checks.R "$content_root" "$root" "$list" || fail=1
  finish
fi

# --- docker を探す場所を PATH に足す（WORKSPACE.md 3 節）---
PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin"
# --- 書き出した中身を、コンテナの中のどこで読むか（WORKSPACE.md 3 節）---
if [ "$mode" = all ]; then
  app_content=/app
else
  app_content=/precommit/index
fi
# --- ホストでは、イメージの R で検査する（WORKSPACE.md 3 節）---
if ! command -v docker >/dev/null 2>&1; then
  ng_docker "docker が見つかりません。R の検査はイメージの R で行います。Docker Desktop を入れて起動してください。"
elif ! docker info >/dev/null 2>&1; then
  ng_docker "Docker が動いていません。Docker Desktop を起動してから、もう一度 commit してください（R の検査に使います）。"
else
  image="$(docker compose config --images 2>/dev/null | head -n 1)"
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    ng_docker "イメージ（${image}）がありません。先に make build を実行してください（R の検査に使います）。"
  else
    docker compose --progress quiet run --rm -T --user rstudio -v "${tmp}:/precommit:ro" task \
      Rscript --vanilla tools/precommit_checks.R "$app_content" /app /precommit/files \
      || fail=1
  fi
fi

# --- 指摘があればコミットを止める（WORKSPACE.md 3 節）---
finish
